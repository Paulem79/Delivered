# These are read from the real environment too: a .env file is optional.
# Default port for the server to listen on
PORT=3000
# Address to bind to (use 127.0.0.1 when behind a reverse proxy)
BIND_ADDR=0.0.0.0
# Files directory path
FILES_DIR=./files
# Sub-directory of FILES_DIR whose .mp4 files are exposed as HLS on /api/stream
STREAM_DIR=stream
# Nominal HLS segment length in seconds; real cuts land on the next keyframe
HLS_TARGET_DURATION=6
